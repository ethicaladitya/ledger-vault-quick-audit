# Copy to .env (or run ./setup.sh, which generates random secrets for you).
POSTGRES_DB=ledgervault
POSTGRES_USER=ledgervault
POSTGRES_PASSWORD=change-this-before-deploying
DATABASE_URL=postgresql+psycopg://ledgervault:change-this-before-deploying@db:5432/ledgervault
# At least 32 random characters: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
# Your public domain for automatic HTTPS, e.g. ledger.example.com. Leave empty for http://localhost.
SITE_ADDRESS=
# The first account can always register. Set true to let anyone else create an account too.
ALLOW_REGISTRATION=false
